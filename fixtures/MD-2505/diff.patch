+<?php
+
+/**
+ * This file is part of the Pistor.ch mercanto project.
+ * For full license information, please view the LICENSE file that was distributed with this source code.
+ */
+
+declare(strict_types=1);
+
+namespace PyzTest\Zed\SalesMerchantPortalGui\Communication\ConfigurationProvider;
+
+use Codeception\Test\Unit;
+use Generated\Shared\Transfer\MerchantOrderTransfer;
+use Pyz\Shared\GuiTable\GuiTableFactory;
+use Pyz\Zed\SalesMerchantPortalGui\Communication\ConfigurationProvider\MerchantOrderItemGuiTableConfigurationProvider as ConfigProvider;
+use PyzTest\Zed\SalesMerchantPortalGui\SalesMerchantPortalGuiCommunicationTester;
+use Spryker\Zed\SalesMerchantPortalGui\Dependency\Facade\SalesMerchantPortalGuiToMerchantOmsFacadeInterface;
+use Spryker\Zed\SalesMerchantPortalGui\Dependency\Facade\SalesMerchantPortalGuiToMerchantUserFacadeInterface;
+use Spryker\Zed\SalesMerchantPortalGui\Dependency\Facade\SalesMerchantPortalGuiToTranslatorFacadeInterface;
+
+/**
+ * Auto-generated group annotations
+ *
+ * @group PyzTest
+ * @group Zed
+ * @group SalesMerchantPortalGui
+ * @group Communication
+ * @group ConfigurationProvider
+ * @group MerchantOrderItemGuiTableConfigurationProviderTest
+ * Add your own group annotations below this line
+ */
+class MerchantOrderItemGuiTableConfigurationProviderTest extends Unit
+{
+    protected SalesMerchantPortalGuiCommunicationTester $tester;
+
+    /**
+     * @return void
+     */
+    public function testDepositColumnIsAddedWhenFeatureFlagEnabled(): void
+    {
+        // Arrange
+        $this->tester->setFeatureFlagsEnabled();
+
+        // Act
+        $columnIds = $this->getConfiguredColumnIds();
+
+        // Assert
+        self::assertContains(ConfigProvider::COL_KEY_DEPOSIT, $columnIds);
+        self::assertContains(ConfigProvider::COL_KEY_TOTAL, $columnIds);
+    }
+
+    /**
+     * @return void
+     */
+    public function testDepositColumnIsNotAddedWhenFeatureFlagDisabled(): void
+    {
+        // Arrange
+        $this->tester->setFeatureFlagDisabled();
+
+        // Act
+        $columnIds = $this->getConfiguredColumnIds();
+
+        // Assert
+        self::assertNotContains(ConfigProvider::COL_KEY_DEPOSIT, $columnIds);
+        self::assertContains(ConfigProvider::COL_KEY_TOTAL, $columnIds);
+    }
+
+    /**
+     * @return array<int, string>
+     */
+    private function getConfiguredColumnIds(): array
+    {
+        $configurationProvider = new ConfigProvider(
+            $this->createMock(SalesMerchantPortalGuiToMerchantOmsFacadeInterface::class),
+            $this->createMock(SalesMerchantPortalGuiToMerchantUserFacadeInterface::class),
+            new GuiTableFactory(),
+            $this->createMock(SalesMerchantPortalGuiToTranslatorFacadeInterface::class),
+            [],
+        );
+
+        $guiTableConfigurationTransfer = $configurationProvider->getConfiguration(new MerchantOrderTransfer());
+
+        $columnIds = [];
+        foreach ($guiTableConfigurationTransfer->getColumns() as $columnTransfer) {
+            $columnIds[] = $columnTransfer->getId();
+        }
+
+        return $columnIds;
+    }
+}

