+namespace Pyz\Zed\ProductDeposit\Communication\Plugin\Sales;
+
+use Spryker\Zed\Kernel\Communication\AbstractPlugin;
+use Spryker\Zed\SalesExtension\Dependency\Plugin\OrderItemExpanderPluginInterface;
+
+/**
+ * @method \Pyz\Zed\ProductDeposit\Business\ProductDepositFacadeInterface getFacade()
+ * @method \Pyz\Zed\ProductDeposit\Communication\ProductDepositCommunicationFactory getFactory()
+ * @method \Pyz\Zed\ProductDeposit\ProductDepositConfig getConfig()
+ */
+class ProductDepositOrderItemExpanderPlugin extends AbstractPlugin implements OrderItemExpanderPluginInterface
+{
+    /**
+     * {@inheritDoc}
+     *
+     * @api
+     *
+     * @param array<\Generated\Shared\Transfer\ItemTransfer> $itemTransfers
+     *
+     * @return array<\Generated\Shared\Transfer\ItemTransfer>
+     */
+    public function expand(array $itemTransfers): array
+    {
+        $productDepositService = $this->getFactory()->getProductDepositService();
+        foreach ($itemTransfers as $itemTransfer) {
+            $productDepositService->hydrateItemDepositsFromMetadata($itemTransfer);
+        }
+
+        return $itemTransfers;
+    }
+}
